# Copy to backend/.env or export directly. Never commit real secrets.
VAUTH_ENV=development
# demo = deterministic heuristic (labelled)
# ml|aasist|spectra|spectra3|w2v2_aasist = real checkpoints (see models/benchmarks)
VAUTH_DETECTOR=demo
VAUTH_MODEL_PATH=models/AASIST.pth
VAUTH_DEVICE=cpu
VAUTH_WINDOW_SECONDS=2.5
VAUTH_ROLLING_SIZE=5
VAUTH_STORE_RAW_AUDIO=false
VAUTH_CORS_ORIGINS=*
# Optional Twilio (local demo works WITHOUT these):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
