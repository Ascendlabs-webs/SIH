# Copy to backend/.env or export directly. Never commit real secrets.
VAUTH_ENV=development
# demo = deterministic heuristic (labelled)
# ml|aasist|spectra|spectra3|w2v2_aasist = real checkpoints (see models/benchmarks)
VAUTH_DETECTOR=demo
VAUTH_MODEL_PATH=models/AASIST.pth
VAUTH_DEVICE=cpu
VAUTH_WINDOW_SECONDS=2.5
VAUTH_ROLLING_SIZE=5
VAUTH_STORE_RAW_AUDIO=false
VAUTH_CORS_ORIGINS=*
# Optional Twilio (local demo works WITHOUT these):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional Vonage Voice API input adapter (disabled by default; local demo
# works WITHOUT these). Enable only with a public HTTPS/WSS host.
VONAGE_ENABLED=false
VONAGE_PUBLIC_WS_HOST=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
VONAGE_NUMBER=
VONAGE_VERIFY_JWT=true
VONAGE_WS_AUTH_TOKEN=
